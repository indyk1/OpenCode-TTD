{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "senior-dev",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx", "-y", "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--allowed-origins", "http://localhost:*;https://localhost:*",
        "--blocked-origins", "http://localhost:6502",
        "--secrets", ".workflow/debugger.env"
      ],
      "enabled": true
    },
    "aspire": {
      "type": "local",
      "command": ["aspire", "agent", "mcp", "--non-interactive", "--nologo"],
      "enabled": true
    },
    "roslynk": {
      "type": "local",
      "command": ["dnx", "Roslynk@2.0.0", "--yes", "--", "stdio"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      ".workflow/*": "deny"
    },
    "bash": {
      "*lock-tests.sh*": "ask",
      "*finish-change.sh*": "ask",
      "openspec archive*": "ask",
      "aspire deploy*": "ask",
      "aspire destroy*": "ask"
    },
    "skill": {
      "openspec-*": "deny",
      "roslynk": "deny"
    },
    "playwright_*": "deny",
    "aspire_*": "deny",
    "roslynk_*": "deny"
  }
}
